# ==================== CLASS 8: SERVER ENVIRONMENT ====================
# Copy this file to .env, then replace the placeholder with your own key.
# Never put a real secret in .env.example because this example can be committed.
OPENAI_API_KEY=""

# Use a cost-conscious model that supports the Responses API and Structured Outputs.
OPENAI_MODEL=gpt-5-mini

# Keep this false for a real API call. Change it to true only for an offline demo.
OPENAI_DEMO_MODE=false
# ====================================================================
